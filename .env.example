# Copy to .env and fill in. Never put real keys in this file.
# Primary provider used by the agent (any OpenAI-compatible endpoint).
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.z.ai/api/paas/v4/
LLM_MODEL=glm-5.2

# Optional extra providers, used only by the smoke-test benchmark.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- ResolveAI API service (Phase 7). Not secrets; every line is optional. ---
# RESOLVEAI_ENV=development                  # development | demo | test | production (see below)
# RESOLVEAI_CORS_ORIGINS=http://localhost:3000
# RESOLVEAI_USE_LLM=true                     # false = deterministic path only (handoffs/clarifications, no drafts)
# RESOLVEAI_WRITE_TRACES=true
# RESOLVEAI_TRACE_DIR=traces
# RESOLVEAI_EAGER_LOAD=true
# RESOLVEAI_EXPOSE_DOCS=true
# RESOLVEAI_RATE_LIMIT_PER_MINUTE=60
# RESOLVEAI_MAX_QUEUE=4
# RESOLVEAI_MAX_BODY_BYTES=64000
# RESOLVEAI_MAX_MESSAGE_CHARS=2000
# RESOLVEAI_MAX_TURN_CHARS=2000
# RESOLVEAI_MAX_TURNS=20
# RESOLVEAI_MAX_TOTAL_CHARS=12000

# --- Phase 9: authentication, rate limits and time budgets. ---
# RESOLVEAI_ENV=production                   # production requires RESOLVEAI_API_TOKEN and refuses RESOLVEAI_AUTH_REQUIRED=false
# RESOLVEAI_AUTH_REQUIRED=false               # development/demo/test default; true turns authentication on
# RESOLVEAI_API_TOKEN=                        # SECRET, at least 32 random characters: resolve + read scopes (never commit a value)
# RESOLVEAI_READ_TOKEN=                       # SECRET, at least 32 random characters: read-only scope (never commit a value)
# RESOLVEAI_READ_RATE_LIMIT_PER_MINUTE=600
# RESOLVEAI_AUTH_FAILURES_PER_MINUTE=30
# RESOLVEAI_QUEUE_TIMEOUT_S=30
# RESOLVEAI_REQUEST_BUDGET_S=60               # production profile default: 45
