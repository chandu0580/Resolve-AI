# ResolveAI console. Copy to .env.local if the API is not on the default address.
# Server-side only: the browser always talks to the console's own /api/v1/* forwarder, never to this address.
RESOLVEAI_API_URL=http://127.0.0.1:8000
# Timeout for forwarded requests in milliseconds (live model calls on /resolve can take tens of seconds).
RESOLVEAI_PROXY_TIMEOUT_MS=190000
# Required when the API runs with authentication (production profile). Server-side only; never exposed to the browser.
# Use a token with the `resolve` scope (the API's RESOLVEAI_API_TOKEN). Leave empty when API auth is disabled.
RESOLVEAI_API_TOKEN=
